# Copy to apps/web/.env for local overrides. The default is the production URL.
# A local URL here fails the build's go-live check (post-audit), so only set it for experiments.
# PUBLIC_SITE_URL=http://localhost:5156

# Cloudflare account for `pnpm deploy:solar`; wrangler reads it from the environment.
# CLOUDFLARE_ACCOUNT_ID=
