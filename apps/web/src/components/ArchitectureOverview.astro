---

const { locale } = Astro.props as { locale: string };
const de = locale === 'de';
const copy = de
  ? {
      title: 'So ist der Solarrechner aufgebaut',
      intro:
        'Die Website liefert die Oberfläche und öffentliche Referenzdaten aus. Eingaben, stündliche Berechnung und Ergebnisexport sind im Browser verbunden. Nur ein bestätigter Ertragsabruf für einen Standort benötigt den Server.',
      caption:
        'Vereinfachte Architektur der laufenden Demo · Diagramm mit Chartlet beim Build erzeugt.',
      steps: [
        [
          'Start ohne Datenabruf',
          'Astro liefert die Seite mit einem vorbereiteten Berliner Ertragsprofil. Die Ortssuche verwendet einen lokal ausgelieferten GeoNames-Snapshot. Für Haushalts-, Kosten- oder Speicheränderungen ist kein erneuter PVGIS-Aufruf nötig.',
        ],
        [
          'Ein gemeinsames Ergebnis',
          'Svelte verwaltet die Eingaben. Reine TypeScript-Funktionen gleichen Erzeugung und Bedarf stündlich ab und berechnen daraus Speicherwirkung, Kosten, Finanzierung und Amortisation. Chartlet, Open Grid und der PDF-Bericht übernehmen dieselben berechneten Werte.',
        ],
        [
          'Standortdaten nach Bestätigung',
          'Beim bestätigten Abruf gehen Koordinaten, Neigung und Ausrichtung an den eigenen Cloudflare-Endpunkt. Dieser prüft die Parameter, fragt PVGIS ab und hält öffentliche Ertragsprofile vorübergehend im Cache. Das zurückgegebene Profil fließt in die lokale Rechnung ein.',
        ],
        [
          'Ergebnisse lokal mitnehmen',
          'Chartlet erzeugt die Kurven, Open Grid zeigt die Tabellen. Lightweight PDF wird erst für den PDF-Download geladen. PDF und JSON werden im Browser erzeugt; die Anwendung sendet Haushalts- und Finanzwerte nicht an einen Rechen- oder PDF-Dienst.',
        ],
      ],
    }
  : {
      title: 'How the solar calculator is built',
      intro:
        'The website serves the interface and public reference data. Inputs, hourly calculations and result exports are connected in the browser. Only a confirmed request for location-specific yield data requires the server.',
      caption:
        'Simplified architecture of the running demo · Diagram generated with Chartlet at build time.',
      steps: [
        [
          'Start without a data request',
          'Astro serves the page with a bundled Berlin yield profile. Place search uses a locally served GeoNames snapshot. Changing household, cost or battery inputs does not trigger another PVGIS request.',
        ],
        [
          'One shared result',
          'Svelte manages inputs. Pure TypeScript functions match generation and demand hour by hour and calculate battery performance, costs, financing and payback. Chartlet, Open Grid and the PDF report use the same calculated values.',
        ],
        [
          'Location data on confirmation',
          'A confirmed request sends coordinates, tilt and orientation to the Cloudflare endpoint. It validates parameters, queries PVGIS and temporarily caches public yield profiles. The returned profile feeds into the local calculation.',
        ],
        [
          'Take results with you locally',
          'Chartlet renders charts and Open Grid presents tables. Lightweight PDF loads only when creating a PDF download. PDF and JSON exports are generated in the browser; the application does not send household or financial values to a calculation or PDF service.',
        ],
      ],
    };
---
<section class="architecture-overview mb-10" aria-labelledby="architecture-heading">
  <h2 id="architecture-heading" class="mb-4 text-2xl font-bold">{copy.title}</h2>
  <p class="mb-6 leading-relaxed">{copy.intro}</p>
  <figure class="architecture-diagram"><img src={`/vendor/architecture-${de ? 'de' : 'en'}.svg`} alt={de ? 'Astro liefert die Svelte-Oberfläche. Das Rechenmodell im Browser versorgt Chartlet, Open Grid und den PDF-Export. Der bestätigte Standortabruf läuft über den Cloudflare-Endpunkt zu PVGIS.' : 'Astro serves the Svelte interface. The browser calculation model feeds Chartlet, Open Grid and PDF export. Confirmed location requests reach PVGIS through the Cloudflare endpoint.'} width="900" height="850" loading="lazy" /><figcaption class="mt-3 text-sm text-text-secondary">{copy.caption}</figcaption></figure>
  <a href={`/vendor/architecture-${de ? 'de' : 'en'}.svg`}>{de ? 'Diagramm in voller Größe öffnen' : 'Open full-size diagram'}</a>
  <dl class="mt-6 space-y-4">
    {copy.steps.map(([title, description]) => <div><dt class="font-bold">{title}</dt><dd class="leading-relaxed text-text-secondary">{description}</dd></div>)}
  </dl>
</section>
<style>
  .architecture-diagram { max-width: 100%; overflow-x: auto; }
  .architecture-diagram img { display: block; width: 100%; height: auto; }
</style>
