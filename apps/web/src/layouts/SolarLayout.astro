---
import { Schema, SchemaGraph, WebPageSchema } from '@casoon/astro-structured-data/components';
import '@/styles/solar.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
  /** Language versions of this page, including the page itself, as root-relative paths. */
  alternates?: { hreflang: string; href: string }[];
  /** Keeps the page out of search results and the sitemap, e.g. the 404 page. */
  noindex?: boolean;
}
const { title, description, lang = 'de', alternates = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname === '/de/' ? '/' : Astro.url.pathname, Astro.site);
const website = new URL('/#website', Astro.site).href;
const path = Astro.url.pathname;
// "Energie richtig zählen" belongs to Stromversorgung and is linked from there and the footer.
const navItems = [
  { href: '/', label: 'Rechner', current: path === '/' },
  { href: '/de/rechenweg/', label: 'Rechenweg' },
  { href: '/de/stromversorgung/', label: 'Stromversorgung', also: '/de/energie-zaehlen/' },
  { href: '/de/stromsystem-2045/', label: 'Stromsystem 2045' },
  { href: '/de/anbieter/', label: 'Anbieter' },
  { href: '/de/about/', label: 'Über', also: '/about/' },
].map((item) => ({
  ...item,
  current:
    item.current ??
    (path.startsWith(item.href) || (item.also !== undefined && path.startsWith(item.also))),
}));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="stylesheet" href="/vendor/chartlet.css" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg?v=ring" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og/home.png', Astro.site)} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'de_DE'} />
    <meta name="theme-color" content="#f7f7f0" />
  </head>
  <body class="solar-site">
    <a class="skip-link" href="#main">Zum Inhalt</a>
    <header class="site-header"><a href="/" class="wordmark"><svg viewBox="0 0 40 40" aria-hidden="true" width="40" height="40"><rect width="40" height="40" rx="9" fill="currentColor" /><circle cx="20" cy="20" r="10" fill="none" stroke="#3d5d53" stroke-width="5" /><path d="M20 10A10 10 0 1 1 10 20" fill="none" stroke="#e6b734" stroke-width="5" stroke-linecap="round" /></svg><span class="wordmark-text">Solarrechner<span>von CASOON</span></span></a><nav aria-label="Hauptnavigation">{navItems.map((item) => <a href={item.href} aria-current={item.current ? "page" : undefined}>{item.label}</a>)}</nav></header>
    <main id="main"><slot /></main>
    <Schema
      item={{
        '@type': 'WebSite',
        '@id': website,
        name: 'Solarrechner',
        url: new URL('/', Astro.site).href,
        description:
          'Kostenloser, anbieterneutraler Rechner für Photovoltaik, Balkonkraftwerk und Speicher. Rechnet auf Basis veränderbarer Annahmen Stunde für Stunde und legt den Rechenweg offen; ohne Anmeldung, Paywall oder Vermittlung von Angeboten.',
        inLanguage: 'de',
        isAccessibleForFree: true,
        license: 'https://opensource.org/licenses/MIT',
        author: { '@type': 'Person', name: 'Jörn Seidel' },
      }}
    />
    <WebPageSchema
      title={title}
      description={description}
      url={canonical.href}
      inLanguage={lang}
      isPartOf={{ id: website }}
      image={new URL('/og/home.png', Astro.site).href}
      imageWidth={1200}
      imageHeight={630}
      author={{ name: 'Jörn Seidel', type: 'Person' }}
      alternates={alternates.length
        ? alternates.map((a) => ({ ...a, href: new URL(a.href, Astro.site).href }))
        : undefined}
      robots={noindex ? 'noindex' : undefined}
    />
    <footer class="site-footer"><p>Eine Demonstration mit Chartlet, Open Grid, Astro & Svelte.</p><a href="/de/rechenweg/">So rechnet der Solarrechner</a><a href="/de/about/">Datenquellen & Methodik</a><a href="/de/energie-zaehlen/">Energie richtig zählen</a><a href="https://github.com/casoon/web-solarrechner">Quellcode auf GitHub</a><a href="https://www.casoon.de/impressum/">Impressum</a><a href="https://www.casoon.de/datenschutz/">Datenschutz</a></footer>
    <SchemaGraph />
  </body>
</html>
