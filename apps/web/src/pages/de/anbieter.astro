    'https://www.pv-magazine.de/2025/10/27/studie-sieht-hohes-einsparpotenzial-durch-dynamische-stromtarife-und-zeitvariable-netzentgelte/',
  ],
  [
    'Bundesnetzagentur: Strommarktdaten 2025 (05.01.2026)',
    'https://bundesnetzagentur.de/SharedDocs/Pressemitteilungen/EN/2026/20260104_SMARD.html',
  ],
  [
    'BDEW-Strompreisanalyse (08/2026)',
    'https://www.bdew.de/media/documents/BDEW_Strompreisanalyse_082026.pdf',
  ],
  ['§ 41a EnWG, dynamische Tarife', 'https://www.gesetze-im-internet.de/enwg_2005/__41a.html'],
