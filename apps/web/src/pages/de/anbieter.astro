---
import OfferComparison from '@/components/OfferComparison.svelte';
import PageIntro from '@/components/PageIntro.astro';
import SolarLayout from '@/layouts/SolarLayout.astro';

const models = [
  {
    name: 'Kauf beim Fachbetrieb',
    how: 'Du kaufst die Anlage beim Handwerksbetrieb vor Ort und bist von Anfang an Eigentümer und Betreiber. Stromtarif und Energiemanagement wählst du selbst.',
    pro: 'Meist der niedrigste Preis je kWp; freie Wahl von Tarif, Messstellenbetreiber und Komponenten; Ansprechpartner in der Nähe.',
    contra:
      'Kapital oder eigener Kredit nötig; Wartung, Versicherung und Ersatzgeräte organisierst du selbst.',
    fit: 'Wer Eigenkapital oder günstigen Kredit hat und sich um Angebote kümmern mag.',
  },
  {
    name: 'Kauf beim Komplettanbieter',
    how: 'Bundesweite Komplettanbieter verkaufen Anlage, Speicher, Wallbox, Energiemanager und oft einen eigenen dynamischen Tarif als Paket, mit Beratung per Video und eigenen Montageteams.',
    pro: 'Alles aus einer Hand, schnelle Terminplanung, Software zur Steuerung von Speicher, Auto und Wärmepumpe.',
    contra:
      'Paketpreise lassen sich schwer mit Einzelangeboten vergleichen; laufendes Software-Abo; Tarif und Energiemanager sind oft an die eigene Hardware gebunden. Fällt der Anbieter aus, fehlen Service und Software.',
    fit: 'Wer wenig Aufwand möchte und Auto oder Wärmepumpe wirklich steuern lässt.',
  },
  {
    name: 'Miete',
    how: 'Der Anbieter stellt die Anlage auf dein Dach und vermietet sie dir über meist 20 Jahre. Service, Versicherung und Ersatz defekter Teile sind enthalten; danach geht die Anlage meist für einen symbolischen Betrag an dich.',
    pro: 'Kein Kapital, feste Rate, Rundum-Service inklusive Speichertausch.',
    contra:
      'Über die Laufzeit meist deutlich teurer als Kauf; praktisch unkündbar, beim Hausverkauf oder Erbfall muss der Vertrag übernommen oder abgelöst werden. Du bist trotzdem Anlagenbetreiber mit allen Pflichten.',
    fit: 'Wer kein Kapital und keinen Kredit bekommt und den Aufpreis für Service bewusst zahlt.',
  },
  {
    name: 'Dachfläche verpachten',
    how: 'Ein Investor baut und betreibt die Anlage auf deinem Dach und zahlt dafür eine Pacht. Den Strom verkauft er, du beziehst weiter Netzstrom.',
    pro: 'Kein Risiko, keine Arbeit, ein kleiner fester Ertrag.',
    contra:
      'Bei Einfamilienhäusern selten angeboten; Laufzeit 20 bis 30 Jahre, Sicherung im Grundbuch, Dachsanierung und Rückbau müssen geregelt sein. Keine Stromersparnis.',
    fit: 'Große Scheunen-, Hallen- und Gewerbedächer; beim Einfamilienhaus eher die Ausnahme.',
  },
  {
    name: 'Solarstrom vom Dach kaufen (Contracting)',
    how: 'Ein Betreiber baut die Anlage auf deinem Dach und verkauft dir ihren Strom zu einem festen Preis je kWh. Ähnlich funktionieren Mieterstrom und die gemeinschaftliche Gebäudeversorgung im Mehrfamilienhaus.',
    pro: 'Günstiger Solarstrom ohne Investition, kein Betreiberaufwand.',
    contra:
      'Der Preisvorteil gegenüber Netzstrom ist begrenzt; lange Bindung; die Einspeisevergütung bekommt der Betreiber.',
    fit: 'Mehrfamilienhäuser, Eigentümergemeinschaften, Vermieter.',
  },
];
const sources = [
  [
    'Verbraucherzentrale: Photovoltaik mieten statt kaufen (23.07.2026)',
    'https://www.verbraucherzentrale.de/wissen/energie/erneuerbare-energien/photovoltaik-solaranlage-mieten-eine-alternative-zum-kauf-71086',
  ],
  [
    'Verbraucherzentrale: Dynamische Stromtarife (06.10.2025)',
    'https://www.verbraucherzentrale.de/wissen/energie/preise-tarife-anbieterwechsel/dynamische-stromtarife-fuer-wen-es-sich-lohnt-und-worauf-sie-achten-sollten-97836',
  ],
  [
    'Verbraucherzentrale: Smart Meter und Preisobergrenzen (10.08.2026)',
    'https://www.verbraucherzentrale.de/wissen/energie/preise-tarife-anbieterwechsel/smart-meter-was-sie-ueber-die-stromzaehler-wissen-muessen-13275',
  ],
  [
    'Verbraucherzentrale NRW: Checkliste Photovoltaik (07/2024)',
    'https://www.verbraucherzentrale.nrw/sites/default/files/2024-07/checkliste_photovoltaik_edit_final.pdf',
  ],
  [
    'pv magazine: Studie zu dynamischen Tarifen und zeitvariablen Netzentgelten (27.10.2025)',
    'https://www.pv-magazine.de/2025/10/27/studie-sieht-hohes-einsparpotenzial-durch-dynamische-stromtarife-und-zeitvariable-netzentgelte/',
  ],
  [
    'Bundesnetzagentur: Strommarktdaten 2025 (05.01.2026)',
    'https://bundesnetzagentur.de/SharedDocs/Pressemitteilungen/EN/2026/20260104_SMARD.html',
  ],
  [
    'BDEW-Strompreisanalyse (08/2026)',
    'https://www.bdew.de/media/documents/BDEW_Strompreisanalyse_082026.pdf',
  ],
  ['§ 41a EnWG, dynamische Tarife', 'https://www.gesetze-im-internet.de/enwg_2005/__41a.html'],
  ['§ 51 EEG, negative Preise', 'https://www.gesetze-im-internet.de/eeg_2014/__51.html'],
];
---
<SolarLayout title="Kaufen, mieten, verpachten – Anbieter-Modelle im Vergleich" description="Anbieterneutral und kostenlos: Kauf, Miete, Dachpacht und dynamische Stromtarife der Komplettanbieter im Vergleich – was sie kosten, wo die Haken liegen.">
  <PageIntro
    title="Kaufen, mieten oder Dach verpachten?"
    facts={[{ title: 'Konzepte, keine Angebote', text: 'Typische Konditionen, alle veränderbar' }, { title: 'Gleiche Energiebilanz', text: 'Stündlich gerechnet, Berliner Sonnendaten' }]}
    link={{ href: '#konzepte', label: 'Vor- und Nachteile lesen' }}
  >Bundesweite Komplettanbieter verkaufen Solaranlage, Speicher und dynamischen Stromtarif als Paket, zum Kauf oder zur Miete. Hier rechnest du die Konzepte grundsätzlich gegeneinander, mit eigenen Annahmen und unabhängig von deiner Anlage im Rechner.</PageIntro>
  <noscript><p class="error">Für die interaktive Rechnung wird JavaScript benötigt. Die Einordnung der Modelle weiter unten ist auch ohne JavaScript lesbar.</p></noscript>
  <OfferComparison client:load />

  <article class="method-page" id="konzepte">
    <section>
      <h2>Die Modelle im Überblick</h2>
      <p class="lead">Alle bringen Solarstrom aufs Dach. Sie unterscheiden sich darin, wem die Anlage gehört, wer das Risiko trägt und wie lange du gebunden bist.</p>
      <ul class="cards model-cards">
        {models.map((m) => (
          <li>
            <h3>{m.name}</h3>
            <p>{m.how}</p>
            <dl>
              <div><dt>Plus</dt><dd>{m.pro}</dd></div>
              <div><dt>Minus</dt><dd>{m.contra}</dd></div>
              <div><dt>Für</dt><dd>{m.fit}</dd></div>
            </dl>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Dynamische Stromtarife: was sie bringen</h2>
      <p class="lead">Seit 2025 muss jeder Lieferant einen anbieten (§ 41a EnWG). Der Preis folgt viertelstündlich der Börse; nötig ist ein Smart Meter, freiwillig für bis zu 30 € im Jahr.</p>
      <ul class="cards">
        <li><span class="figure">⅔ fest</span><p>Netzentgelte, Steuern und Abgaben am Haushaltspreis von 37 ct/kWh (BDEW)</p></li>
        <li><span class="figure">8,9 ct/kWh</span><p>mittlerer Börsenpreis 2025, in 573 Stunden negativ</p></li>
        <li><span class="figure">1–4 %</span><p>Ersparnis ohne steuerbare Geräte (Studie, 10/2025)</p></li>
        <li><span class="figure">rund 31 %</span><p>mit gesteuert geladenem E-Auto, Wärmepumpe 7 %</p></li>
      </ul>
      <p>Die Verbraucherzentrale hält dynamische Tarife für normale Haushalte meist nicht für lohnend. Im Rechner stecken sie in drei eigenen Annahmen: verschiebbarer Anteil, Ersparnis je verschobener kWh, Zusatzkosten.</p>
    </section>

    <section>
      <h2>Kritik an den Paketen</h2>
      <ul class="cards">
        <li><span class="tag">Gesamtkosten</span><p>Miete ist laut Verbraucherzentrale meist teurer als Kauf; manche Anbieter rechnen mit zwei- bis dreimal so hohen Strompreissteigerungen wie üblich. Der Rechner zeigt den Kreditzins, dem die Miete entspricht.</p></li>
        <li><span class="tag">Lock-in</span><p>Paket-Tarife gibt es teils nur zusammen mit Anlage, Messstelle und Energiemanager desselben Anbieters. Beworbene Arbeitspreise enthalten mitunter schon Rabatte auf Netzentgelte und liegen effektiv deutlich höher.</p></li>
        <li><span class="tag">Anbieterrisiko</span><p>Seit 2025 sind mehrere Komplettanbieter in Insolvenz oder Eigenverwaltung gegangen, andere haben ihre Mietanlagen an Investoren verkauft. Über 20 Jahre ist der Vertragspartner von heute nicht sicher der von morgen.</p></li>
        <li><span class="tag">Solarspitzengesetz</span><p>Keine Vergütung bei negativen Preisen, ohne Smart Meter nur 60 % Einspeisung. Das macht Steuerung wertvoller und ist das wichtigste Verkaufsargument der Pakete.</p></li>
      </ul>
      <p>Dafür sprechen: kein Kapital, Service aus einer Hand und eine Steuerung, die Auto, Wärmepumpe und Speicher wirklich nach Preisen fährt. Ob sich der Aufpreis lohnt, hängt fast nur davon ab, wie viel Verbrauch sich verschieben lässt.</p>
    </section>

    <section>
      <aside class="energy-note">
        <h3>Ökostrom statt eigener Anlage</h3>
        <p>Rechnet sich keines der Modelle, etwa bei wenig Verbrauch, ungünstigem Dach oder Bedarf vor allem im Winter, ist ein Ökostromtarif oft die nüchternere Wahl: ohne Investition und ohne 20 Jahre Bindung. Achte auf Labels wie „Grüner Strom“ oder „ok-power“, die den Ausbau neuer Anlagen verlangen. Den Tarifpreis trägst du oben als Arbeitspreis ein.</p>
      </aside>
    </section>

    <details class="more">
      <summary>Was das Modell vereinfacht</summary>
      <p>Alle Modelle nutzen die stündliche Energiebilanz des Rechners mit Berliner Sonnendaten (35° Süd), synthetischem Verbrauchsprofil und 60 % Exportlimit; Kauf und Miete dieselbe Anlage. Restwert, Steuern, Förderung, Netzladen des Speichers und zeitvariable Netzentgelte fehlen, ebenso Geräteeigenheiten wie Speicherkühlung. Pacht, Mietrate, Anbieteraufschlag und Tarifannahmen sind Größenordnungen, keine Angebotspreise. Für deine eigene Anlage nutze den <a href="/">Rechner</a> und den <a href="/de/rechenweg/">Rechenweg</a>.</p>
    </details>
    <details class="more">
      <summary>Quellen</summary>
      <p>Abgerufen am 30.10.2026. Mietraten, Übernahmepreis und Dachpacht stammen aus Ratgeber- und Anbieterangaben und sind nicht amtlich belegt.</p>
      <ul class="source-list">{sources.map(([title, url]) => <li><a href={url}>{title}</a></li>)}</ul>
    </details>
  </article>
</SolarLayout>
