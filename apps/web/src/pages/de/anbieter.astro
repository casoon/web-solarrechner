---
import OfferComparison from '@/components/OfferComparison.svelte';
import SolarLayout from '@/layouts/SolarLayout.astro';

const models = [
  {
    name: 'Kauf beim Fachbetrieb',
    how: 'Du kaufst die Anlage beim Handwerksbetrieb vor Ort und bist von Anfang an Eigentümer und Betreiber. Stromtarif und Energiemanagement wählst du selbst.',
    pro: 'Meist der niedrigste Preis je kWp; freie Wahl von Tarif, Messstellenbetreiber und Komponenten; Ansprechpartner in der Nähe.',
    contra:
      'Kapital oder eigener Kredit nötig; Wartung, Versicherung und Ersatzgeräte organisierst du selbst.',
    fit: 'Wer Eigenkapital oder günstigen Kredit hat und sich um Angebote kümmern mag.',
  },
  {
    name: 'Kauf beim Komplettanbieter',
    how: 'Bundesweite Komplettanbieter verkaufen Anlage, Speicher, Wallbox, Energiemanager und oft einen eigenen dynamischen Tarif als Paket, mit Beratung per Video und eigenen Montageteams.',
    pro: 'Alles aus einer Hand, schnelle Terminplanung, Software zur Steuerung von Speicher, Auto und Wärmepumpe.',
    contra:
      'Paketpreise lassen sich schwer mit Einzelangeboten vergleichen; laufendes Software-Abo; Tarif und Energiemanager sind oft an die eigene Hardware gebunden. Fällt der Anbieter aus, fehlen Service und Software.',
